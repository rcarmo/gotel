receivers:
  otlp:
    protocols:
      grpc:
        endpoint: ${env:GOTEL_OTLP_HOST:-127.0.0.1}:4317
      http:
        endpoint: ${env:GOTEL_OTLP_HOST:-127.0.0.1}:4318

processors:
  batch:
    timeout: 5s
    send_batch_size: 1000
  memory_limiter:
    check_interval: 1s
    limit_mib: 512
    spike_limit_mib: 128

exporters:
  sqlite:
    db_path: gotel.db
    prefix: otel
    namespace: ""
    send_metrics: true
    store_traces: true
    retention: 168h
    cleanup_interval: 1h
    query_port: 3200
    query_host: 127.0.0.1
    allowed_origins: []

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [sqlite]
